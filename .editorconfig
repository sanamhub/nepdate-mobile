root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.bat]
end_of_line = crlf

# ios/.swift-format sets two spaces; ktlint's Kotlin settings are in android/.editorconfig.
[*.{swift,sh}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
