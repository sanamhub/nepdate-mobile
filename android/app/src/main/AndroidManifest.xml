<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Requested only when the person turns on the status bar date (ADR-0013). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Glance's WorkManager dependency declares these; v1 uses neither network nor foreground
         work, and ADR-0007 allows only the boot receiver. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WAKE_LOCK"
        tools:node="remove" />

    <application
        android:name=".NepdateApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nepdate">

        <!-- configChanges: a language switch (first run or Settings) redraws in place through
             Compose instead of recreating the activity, which flashed and jumped the screen. Some
             phones (OnePlus) send keyboard, touchscreen and screen size bits with a per-app language
             change, so those are listed too. Theme (uiMode) and density still recreate. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="locale|layoutDirection|keyboard|keyboardHidden|touchscreen|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Nepdate.Launch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.WidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Nepdate">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Widget receivers. android:icon is a PNG, not a vector or the adaptive launcher icon:
             the OnePlus widget list drew both as a red tile with a blank white square. -->
        <receiver
            android:name=".widget.TodayGlanceWidgetReceiver"
            android:exported="true"
            android:icon="@drawable/widget_picker_icon"
            android:label="@string/widget3_today_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <receiver
            android:name=".widget.UpcomingGlanceWidgetReceiver"
            android:exported="true"
            android:icon="@drawable/widget_picker_icon"
            android:label="@string/widget3_upcoming_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_upcoming_info" />
        </receiver>

        <receiver
            android:name=".widget.MonthGlanceWidgetReceiver"
            android:exported="true"
            android:icon="@drawable/widget_picker_icon"
            android:label="@string/widget_month_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_month_info" />
        </receiver>

        <receiver
            android:name=".widget.NextFestivalGlanceWidgetReceiver"
            android:exported="true"
            android:icon="@drawable/widget_picker_icon"
            android:label="@string/widget3_countdown_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_festival_info" />
        </receiver>

        <receiver
            android:name=".widget.FestivalsGlanceWidgetReceiver"
            android:exported="true"
            android:icon="@drawable/widget_picker_icon"
            android:label="@string/widget2_festivals_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_festivals_info" />
        </receiver>

        <receiver
            android:name=".widget.DateChipGlanceWidgetReceiver"
            android:exported="true"
            android:icon="@drawable/widget_picker_icon"
            android:label="@string/widget3_chip_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_chip_info" />
        </receiver>

        <receiver
            android:name=".widget.DateStripGlanceWidgetReceiver"
            android:exported="true"
            android:icon="@drawable/widget_picker_icon"
            android:label="@string/widget3_strip_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_strip_info" />
        </receiver>

        <receiver
            android:name=".widget.TextDateGlanceWidgetReceiver"
            android:exported="true"
            android:icon="@drawable/widget_picker_icon"
            android:label="@string/widget4_text_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_text_info" />
        </receiver>

        <receiver
            android:name=".widget.WeekGlanceWidgetReceiver"
            android:exported="true"
            android:icon="@drawable/widget_picker_icon"
            android:label="@string/widget3_week_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>

        <receiver
            android:name=".schedule.MidnightAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".schedule.SystemChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
