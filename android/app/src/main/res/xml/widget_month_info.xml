<?xml version="1.0" encoding="utf-8"?>
<!-- previewLayout serves Android 12 to 14 pickers, previewImage older ones; Android 15+ pickers get
     a generated preview from WidgetPreviewPublisher. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:configure="np.nepdate.widget.WidgetConfigActivity"
    android:description="@string/widget_month_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:maxResizeHeight="400dp"
    android:maxResizeWidth="400dp"
    android:minHeight="180dp"
    android:minResizeHeight="180dp"
    android:minResizeWidth="250dp"
    android:minWidth="250dp"
    android:previewImage="@drawable/widget_preview_image_month"
    android:previewLayout="@layout/widget_preview_month"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="4"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional"
    tools:targetApi="31" />
