<?xml version="1.0" encoding="utf-8"?>
<!-- previewLayout serves Android 12 to 14 pickers, previewImage older ones; Android 15+ pickers get
     a generated preview from WidgetPreviewPublisher. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:configure="np.nepdate.widget.WidgetConfigActivity"
    android:description="@string/widget3_chip_description"
    android:initialKeyguardLayout="@layout/glance_default_loading_layout"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:maxResizeHeight="180dp"
    android:maxResizeWidth="180dp"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="40dp"
    android:minWidth="40dp"
    android:previewImage="@drawable/widget_preview_image_chip"
    android:previewLayout="@layout/widget_preview_chip"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|keyguard"
    android:widgetFeatures="reconfigurable|configuration_optional"
    tools:targetApi="31" />
