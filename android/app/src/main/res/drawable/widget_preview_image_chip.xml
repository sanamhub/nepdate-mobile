<?xml version="1.0" encoding="utf-8"?>
<!-- The static widget picker image for launchers before Android 12. Shapes and the Sunny vector
     only: no bitmap. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="80dp" android:height="80dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFF8F3" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:left="24dp" android:top="8dp" android:width="32dp" android:height="6dp" android:gravity="top|start">
        <shape android:shape="rectangle">
            <solid android:color="#FF1F1B16" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:left="16dp" android:top="20dp" android:width="48dp" android:height="48dp" android:gravity="top|start"
        android:drawable="@drawable/widget_sunny" />
</layer-list>
