<?xml version="1.0" encoding="utf-8"?>
<!-- Splash icon (static): the Nepal flag on the 108 grid, crimson with a blue border, a white
     crescent and a white twelve point sun. No icon background, so the flag stands on the splash
     surface. Scaled 1.08 about the centre: with its border it stays inside the 36 unit circle
     Android 12+ shows for an icon without a background. The sun sits in its own group so
     splash_icon_animated can turn it; the flag group grows in. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:name="flag"
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.08"
        android:scaleY="1.08">
        <path
            android:fillColor="@color/splash_flag_crimson"
            android:pathData="M36.4,28.4 L71.6,51.6 L50,51.6 L71.6,79.6 L36.4,79.6 Z"
            android:strokeColor="@color/splash_flag_blue"
            android:strokeLineJoin="round"
            android:strokeWidth="3" />
        <path
            android:fillColor="@color/splash_flag_white"
            android:pathData="M40.57,43.04 A5.6,5.6 0 1,0 51.43,43.04 A5.6,5.6 0 0,1 40.57,43.04 Z" />
        <group
            android:name="sun"
            android:pivotX="46.8"
            android:pivotY="67.6">
            <path
                android:fillColor="@color/splash_flag_white"
                android:pathData="M46.8,59.6 L48.13,62.65 L50.8,60.67 L50.42,63.98 L53.73,63.6 L51.75,66.27 L54.8,67.6 L51.75,68.93 L53.73,71.6 L50.42,71.22 L50.8,74.53 L48.13,72.55 L46.8,75.6 L45.47,72.55 L42.8,74.53 L43.18,71.22 L39.87,71.6 L41.85,68.93 L38.8,67.6 L41.85,66.27 L39.87,63.6 L43.18,63.98 L42.8,60.67 L45.47,62.65 Z" />
        </group>
    </group>
</vector>
