<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash. Theme.Nepdate already switches light and night, and
         splash_background has a night value, so no values-night-v31 copy is needed. -->
    <style name="Theme.Nepdate.Launch">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="android:windowSplashScreenAnimationDuration">500</item>
    </style>
</resources>
