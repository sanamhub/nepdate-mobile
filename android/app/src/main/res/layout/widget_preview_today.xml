<?xml version="1.0" encoding="utf-8"?>
<!-- The static Today preview for Android 12 to 14 pickers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_shape_28"
    android:backgroundTint="#FFDEA8"
    android:orientation="vertical"
    android:padding="14dp"
    tools:ignore="Overdraw,HardcodedText">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_month"
        android:textColor="#271900"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_sunny"
        android:gravity="center"
        android:text="@string/widget3_preview_day"
        android:textColor="#271900"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget3_preview_weekday"
        android:textColor="#271900"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_shape_pill"
        android:backgroundTint="#FFDAD6"
        android:paddingHorizontal="10dp"
        android:layout_marginTop="4dp"
        android:text="@string/widget_preview_holiday"
        android:textColor="#410002"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
