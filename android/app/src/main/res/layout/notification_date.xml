<?xml version="1.0" encoding="utf-8"?>
<!-- The collapsed date card inside the system's decorated notification frame: today's day on the
     marigold Sunny shape, then the BS date and today's holiday or tithi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/notify_day"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_sunny"
        android:gravity="center"
        android:textColor="#271900"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notify_title"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/notify_accent"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notify_line"
            style="@style/TextAppearance.Compat.Notification.Line2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true" />
    </LinearLayout>
</LinearLayout>
