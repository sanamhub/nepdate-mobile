<?xml version="1.0" encoding="utf-8"?>
<!-- The static Festival countdown preview for Android 12 to 14 pickers: the kind as a label, the
     days left large, then the day's names. A public holiday sits on the holiday container. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_shape_28"
    android:backgroundTint="@color/widget_preview_holiday_container"
    android:orientation="vertical"
    android:padding="10dp"
    tools:ignore="Overdraw">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget2_next_holiday_kind"
        android:textColor="@color/widget_preview_on_holiday"
        android:textFontWeight="500"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="bottom"
        android:maxLines="1"
        android:text="@string/widget2_preview_days"
        android:textColor="@color/widget_preview_on_holiday"
        android:textFontWeight="700"
        android:textSize="32sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget2_preview_festival"
        android:textColor="@color/widget_preview_on_holiday"
        android:textFontWeight="500"
        android:textSize="14sp" />
</LinearLayout>
