<?xml version="1.0" encoding="utf-8"?>
<!-- The static Date chip preview for Android 12 to 14 pickers. One cell draws today's numeral on
     the Sunny shape, as the widget does. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_shape_28"
    android:backgroundTint="@color/nepdate_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp"
    tools:ignore="Overdraw">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_sunny">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/widget3_preview_day"
            android:textColor="@color/widget_preview_on_today"
            android:textFontWeight="700"
            android:textSize="20sp" />
    </FrameLayout>
</LinearLayout>
