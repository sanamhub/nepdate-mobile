<?xml version="1.0" encoding="utf-8"?>
<!-- The static Date and tithi preview for Android 12 to 14 pickers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_shape_28"
    android:backgroundTint="@color/nepdate_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp"
    tools:ignore="Overdraw,HardcodedText">

    <TextView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_sunny"
        android:gravity="center"
        android:text="@string/widget3_preview_day"
        android:textColor="#271900"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_date"
            android:textColor="@color/widget_preview_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget3_preview_strip_detail"
            android:textColor="@color/widget_preview_holiday"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
