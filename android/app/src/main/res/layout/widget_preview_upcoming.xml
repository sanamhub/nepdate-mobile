<?xml version="1.0" encoding="utf-8"?>
<!-- The static Today and upcoming preview for Android 12 to 14 pickers: today's block on the left,
     then today's own names as a note and the next day with names and its relative day. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_shape_28"
    android:backgroundTint="@color/nepdate_background"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="8dp"
    tools:ignore="Overdraw">

    <LinearLayout
        android:layout_width="84dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_shape_20"
        android:backgroundTint="@color/widget_preview_today"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget3_preview_month"
            android:textColor="@color/widget_preview_on_today"
            android:textFontWeight="500"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginVertical="2dp"
            android:background="@drawable/widget_sunny">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/widget3_preview_day"
                android:textColor="@color/widget_preview_on_today"
                android:textFontWeight="700"
                android:textSize="20sp" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget3_preview_weekday"
            android:textColor="@color/widget_preview_on_today"
            android:textFontWeight="500"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_shape_12"
            android:backgroundTint="@color/widget_preview_note"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget3_today_name"
                android:textColor="@color/widget_preview_on_note"
                android:textFontWeight="500"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_preview_holiday"
                android:textColor="@color/widget_preview_holiday"
                android:textFontWeight="500"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_shape_12"
                android:backgroundTint="@color/widget_preview_holiday_container"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget3_preview_day_26"
                    android:textColor="@color/widget_preview_on_holiday"
                    android:textFontWeight="700"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget3_preview_week_mon"
                    android:textColor="@color/widget_preview_on_holiday"
                    android:textFontWeight="500"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget3_preview_upcoming_names"
                    android:textColor="@color/widget_preview_holiday"
                    android:textFontWeight="500"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/upcoming_tomorrow"
                    android:textColor="@color/widget_preview_soft"
                    android:textFontWeight="400"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
