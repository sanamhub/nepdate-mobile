<?xml version="1.0" encoding="utf-8"?>
<!-- The static Today and upcoming preview for Android 12 to 14 pickers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_shape_28"
    android:backgroundTint="@color/nepdate_background"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="8dp"
    tools:ignore="Overdraw,HardcodedText">

    <LinearLayout
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_shape_20"
        android:backgroundTint="#FFDEA8"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_month"
            android:textColor="#271900"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/widget_sunny"
            android:gravity="center"
            android:text="@string/widget3_preview_day"
            android:textColor="#271900"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget3_preview_weekday"
            android:textColor="#271900"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget3_upcoming_title"
            android:textColor="@color/widget_preview_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="8dp"
            android:text="@string/widget_preview_upcoming"
            android:textColor="@color/widget_preview_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
